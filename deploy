#!/bin/bash

# Commmand example debug helm chart
# helm template -f values.yaml delta


# Registro de imagenes. Se migro de ECR a Docker Hub: la cuenta de AWS
# 009158394470 quedo suspendida y "aws ecr get-login-password" ya no responde.
#
# En heberestrada/images todos los servicios comparten un mismo repositorio y el
# nombre del servicio va dentro del tag (coatlicue_v1.5.0, tlaloc_v1.5.0, ...).
REGISTRY_SERVER="https://index.docker.io/v1/"
REGISTRY_USER="${DOCKERHUB_USER:-heberestrada}"

# Namespaces donde se crea el regcred. Se puede sobreescribir:
#   NAMESPACES="default" ./deploy generate-pass
NAMESPACES="${NAMESPACES:-delta spartan skadi}"

function fail() {
  local message=$1
  echo "ERROR: $message" >&2
  exit 1
}

function generate_password() {
    openssl rand -hex 32
}

function create_redis_secret() {
  kubectl -n delta create secret generic redis-secret \
      --from-literal=redis-password="$(generate_password)"
}

function setup_previus() {
  apt install unzip
  # Install k8s
  snap install microk8s --classic
  microk8s enable community
  microk8s enable dns dashboard storage metrics-server

  # Install kubectl
  curl -LO "https://dl.k8s.io/release/$(curl -L -s https://dl.k8s.io/release/stable.txt)/bin/linux/amd64/kubectl"
  curl -LO "https://dl.k8s.io/$(curl -L -s https://dl.k8s.io/release/stable.txt)/bin/linux/amd64/kubectl.sha256"
  install -o root -g root -m 0755 kubectl /usr/local/bin/kubectl

  # Only for development
  microk8s config > config
  microk8s config > ~/.kube/config
    
  export KUBECONFIG="$PWD/config"
  chmod 600 "$PWD/config"

  # Install previous requirements
  # awscli y aws-iam-authenticator se instalaban para autenticarse contra ECR.
  # Ya no hacen falta para el registro; se dejan por si algun otro paso los usa.
  curl "https://awscli.amazonaws.com/awscli-exe-linux-x86_64.zip" -o "awscliv2.zip" &&\
  unzip awscliv2.zip && \
  ./aws/install && \
  curl -o aws-iam-authenticator https://amazon-eks.s3.us-west-2.amazonaws.com/1.19.6/2021-01-05/bin/linux/amd64/aws-iam-authenticator && \
  install -o root -g root -m 0755 aws-iam-authenticator /usr/local/bin/aws-iam-authenticator && \
  curl -fsSL -o get_helm.sh https://raw.githubusercontent.com/helm/helm/main/scripts/get-helm-3 && \
  chmod 700 get_helm.sh && \
  ./get_helm.sh && \
  helm repo add bitnami https://charts.bitnami.com/bitnami
  helm repo add hashicorp https://helm.releases.hashicorp.com

  kubectl create namespace argocd
  kubectl create namespace delta
  kubectl create namespace spartan
  kubectl create namespace skadi
  kubectl create namespace vault
  kubectl apply -f https://github.com/kubernetes-sigs/metrics-server/releases/latest/download/components.yaml

  create_redis_secret

  helm install vault hashicorp/vault --namespace vault --version 0.24.0
  helm install vault hashicorp/vault --namespace vault --set "server.dev.enabled=true" --set "server.dev.devRootToken=root" --dry-run
  helm install redis bitnami/redis   --namespace delta --set "auth.existingSecret=redis-secret" --set "auth.existingSecretPasswordKey=redis-password"

  kubectl apply -n delta -f https://raw.githubusercontent.com/oriocuu/centinela/main/Infrastructure/delta-configurations.yaml
  kubectl apply -n skadi -f https://raw.githubusercontent.com/oriocuu/centinela/main/Infrastructure/skadi-configurations.yaml

  # dev
  kubectl apply -n argocd -f https://raw.githubusercontent.com/argoproj/argo-cd/stable/manifests/install.yaml
}

export KUBECONFIG="$PWD/config"
#chmod 600 "$PWD/config"
if ! ([[ -f "$KUBECONFIG" ]] || [[ -f "$HOME/config" ]]); then
  echo "Configuration missing. Setting up local environment" >&2
fi

if [[ -z "$1" ]] ; then
  fail "Use: $0 <deploy> [project_name]"
fi

case "$1" in
  pres)
      setup_previus
      ;;
  generate-pass)
      # A diferencia de ECR, cuyo token vivia 12 horas y obligaba a repetir esto
      # a diario, el PAT de Docker Hub dura lo que se le haya fijado al crearlo.
      # Sólo hay que volver a correrlo cuando el PAT se rote o venza.
      #
      # El token se toma de la variable DOCKERHUB_TOKEN; si no esta, se pide por
      # teclado. No se pasa como argumento para que no quede en el historial ni
      # a la vista en "ps".
      if [[ -z "${DOCKERHUB_TOKEN:-}" ]]; then
        read -rsp "Personal Access Token de Docker Hub para $REGISTRY_USER: " DOCKERHUB_TOKEN
        echo
      fi
      [[ -n "$DOCKERHUB_TOKEN" ]] || fail "no se recibio el token"

      for ns in $NAMESPACES; do
        kubectl get namespace "$ns" >/dev/null 2>&1 || { echo "aviso: el namespace $ns no existe, se omite" >&2; continue; }
        kubectl delete secret regcred --namespace="$ns" --ignore-not-found
        kubectl create secret docker-registry regcred \
          --docker-server="$REGISTRY_SERVER" \
          --docker-username="$REGISTRY_USER" \
          --docker-password="$DOCKERHUB_TOKEN" \
          --namespace="$ns"
      done
      unset DOCKERHUB_TOKEN
      ;;
  *)
    fail "Use: $0 <deploy> [project_name]"
esac
